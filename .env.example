# Токен бота от @BotFather (обязательно для запуска бота; для dry-run не нужен)
BOT_TOKEN=

# Язык по умолчанию: es | ru
DEFAULT_LANG=es

# Кэш данных, сек (условия CriptoYa — не менее 60)
CACHE_TTL_SECONDS=60

# Таймаут HTTP-запросов к источникам, сек
HTTP_TIMEOUT=10

# SQLite-файл с настройками чатов
DB_PATH=bot.db

# Объём USDT по умолчанию, для которого CriptoYa считает цены с комиссиями
# (в чате переключается кнопками 100/500/1000/5000)
USDT_VOLUME_DEFAULT=100

LOG_LEVEL=INFO

# Алерты спреда
ALERT_POLL_SECONDS=60        # период фоновой проверки
ALERT_COOLDOWN_MINUTES=30    # мин. интервал между уведомлениями одного алерта
ALERT_HYSTERESIS_PCT=0.2     # гистерезис порога, п.п. (защита от «дребезга»)

# Binance P2P — прямые объявления (/p2p).
# bapi блокирует дата-центровые IP (403): нужны резидентные AR-прокси.
# Формат: http://user:pass@host:port,... (пусто = напрямую, экран покажет fallback)
PROXY_LIST=
BINANCE_P2P_MIN_COMPLETION=0.90
BINANCE_P2P_PAGES=2
BINANCE_P2P_ROWS=10
